# Environment Configuration for Data Ingestion Pipeline

# Ollama Configuration (for local Llama 3.2 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# HuggingFace Embedding Model
EMBEDDING_MODEL=intfloat/e5-large-v2

# Portkey Configuration (optional - for LLM gateway routing)
PORTKEY_API_KEY=pk-your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Qdrant Vector Database (optional - defaults to local storage)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=  # if using Qdrant Cloud

# Data Pipeline Configuration
DATA_DIR=./data
VECTOR_STORE_PATH=./qdrant_data
COLLECTION_NAME=cancer_data_sharing
CHUNK_SIZE=1024
CHUNK_OVERLAP=200

# Logging Configuration
LOG_LEVEL=INFO
